# VK community token: Управление → Работа с API → Ключи доступа
VK_GROUP_TOKEN=
VK_GROUP_ID=

# PostgreSQL (defaults for docker compose)
POSTGRES_USER=funpay
POSTGRES_PASSWORD=funpay
POSTGRES_DB=funpay

# Database URL for local (non-docker) development
DATABASE_URL=postgresql+asyncpg://funpay:funpay@localhost:5432/funpay

# Application settings
LOG_LEVEL=INFO
PARSE_INTERVAL_MINUTES=15
REQUEST_DELAY_SECONDS=3
ALERT_COOLDOWN_HOURS=6
