# Desktop app: local API and SQLite
API_HOST=127.0.0.1
API_PORT=8765
SCHEDULER_ENABLED=true
# Override the per-user directory that stores funpay-monitor.sqlite3
FUNPAY_DATA_DIR=
LOCAL_USER_VK_ID=0
HISTORY_DAYS=7

# Application settings
LOG_LEVEL=INFO
PARSE_INTERVAL_MINUTES=15
REQUEST_DELAY_SECONDS=3
ALERT_COOLDOWN_HOURS=6

# --- VK bot (optional channel, not used by the desktop build) ---

# VK community token: Управление → Работа с API → Ключи доступа
VK_GROUP_TOKEN=
VK_GROUP_ID=
# VK ids of admins who can use /status and /reparse (comma separated)
VK_ADMIN_IDS=

# PostgreSQL (defaults for docker compose)
POSTGRES_USER=funpay
POSTGRES_PASSWORD=funpay
POSTGRES_DB=funpay

# Database URL for local (non-docker) development
DATABASE_URL=postgresql+asyncpg://funpay:funpay@localhost:5432/funpay

# Delete the /add dialog messages once a subscription is saved (set to false to keep them)
CHAT_CLEANUP_ENABLED=true
